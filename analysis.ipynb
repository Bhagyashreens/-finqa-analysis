   "source": [
    "import collections\n",
    "\n",
    "# Count unique companies\n",
    "companies = [r[\"filename\"].split(\"/\")[0] for r in splits[\"train\"]]\n",
    "unique_companies = len(set(companies))\n",
    "\n",
    "# Count year range\n",
    "years = []\n",
    "for r in splits[\"train\"]:\n",
    "    parts = r[\"filename\"].split(\"/\")\n",
    "    if len(parts) >= 2:\n",
    "        try:\n",
    "            years.append(int(parts[1]))\n",
    "        except:\n",
    "            pass\n",
    "\n",
    "total = sum(len(splits[s]) for s in splits)\n",
    "\n",
    "print(\"=\" * 50)\n",
    "print(f\"  Total records      : {total:,}\")\n",
    "print(f\"  Training set       : {len(splits['train']):,}\")\n",
    "print(f\"  Dev set            : {len(splits['dev']):,}\")\n",
    "print(f\"  Test set           : {len(splits['test']):,}\")\n",
    "print(f\"  Unique companies   : {unique_companies}+\")\n",
    "print(f\"  Year range         : {min(years)}–{max(years)}\")\n",
    "print(\"=\" * 50)"
   ]
