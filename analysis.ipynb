   "source": [
    "# Count reasoning complexity\n",
    "step_counts = collections.Counter(\n",
    "    len(record[\"qa\"][\"steps\"]) for record in splits[\"train\"]\n",
    ")\n",
    "\n",
    "for steps, count in sorted(step_counts.items()):\n",
    "    print(f\"{steps} step(s): {count} questions\")"
   ]
