    "#Questions per year\n",
    "years = []\n",
    "for record in splits[\"train\"]:\n",
    "    parts = record[\"filename\"].split(\"/\")\n",
    "    if len(parts) >= 2:\n",
    "        try:\n",
    "            years.append(int(parts[1]))\n",
    "        except:\n",
    "            pass\n",
    "\n",
    "year_counts = collections.Counter(years)\n",
    "for year in sorted(year_counts):\n",
    "    print(f\"{year}: {year_counts[year]}\")"
   ]
