   "source": [
    "# Count operation types\n",
    "ops = []\n",
    "for record in splits[\"dev\"]:\n",
    "    for step in record[\"qa\"][\"steps\"]:\n",
    "        ops.append(step[\"op\"].split(\"-\")[0])\n",
    "\n",
    "op_counts = collections.Counter(ops)\n",
    "for op, count in op_counts.most_common():\n",
    "    print(f\"{op}: {count}\")"
   ]
  },
