    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as mpatches\n",
    "\n",
    "metrics = [\n",
    "    (\"Total records\", \"8,281\"),\n",
    "    (\"Training set\", \"6,251\"),\n",
    "    (\"Dev set\", \"883\"),\n",
    "    (\"Test set\", \"1,147\"),\n",
    "    (\"Unique companies\", \"~140+\"),\n",
    "    (\"Year range\", \"1999–2019\"),\n",
    "]\n",
    "\n",
    "fig, axes = plt.subplots(2, 4, figsize=(14, 4))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for i, (label, value) in enumerate(metrics):\n",
    "    ax = axes[i]\n",
    "    ax.set_facecolor(\"#f5f5f0\")\n",
    "    ax.text(0.1, 0.65, label, fontsize=11, color=\"gray\", transform=ax.transAxes)\n",
    "    ax.text(0.1, 0.25, value, fontsize=22, fontweight=\"bold\", transform=ax.transAxes)\n",
    "    ax.axis(\"off\")\n",
    "\n",
    "# Hide unused axes\n",
    "for j in range(len(metrics), len(axes)):\n",
    "    axes[j].axis(\"off\")\n",
    "\n",
    "fig.patch.set_facecolor(\"#ffffff\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"metric_cards.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
